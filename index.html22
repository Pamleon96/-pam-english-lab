<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#6c5ce7">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Pam English">
<meta name="mobile-web-app-capable" content="yes">
<meta name="description" content="Pam's personal English learning lab: vocabulary, stories, pronunciation, dictation, games and speaking practice.">
<link rel="manifest" href="manifest.webmanifest">
<title>Pam's English Lab PRO</title>
<style>
:root{
  --bg:#f6f7fb;--card:#fff;--ink:#17172a;--muted:#72738a;--purple:#6c5ce7;
  --purple2:#8d7cf6;--soft:#efedff;--green:#19a974;--greenSoft:#eafaf4;
  --red:#e85d75;--redSoft:#fff0f3;--gold:#efa82c;--goldSoft:#fff7e6;
  --line:#e9e9f2;--shadow:0 18px 50px rgba(31,31,60,.09);--r:24px
}
*{box-sizing:border-box} body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;color:var(--ink);
background:radial-gradient(circle at 5% 0,#eeeaff 0,transparent 25%),radial-gradient(circle at 95% 5%,#e9faf4 0,transparent 23%),var(--bg)}
button,input,select{font:inherit}.app{max-width:1220px;margin:auto;padding:28px 18px 70px}
.hero{background:linear-gradient(135deg,#1e1949,#6c5ce7 68%,#8f80ff);color:#fff;border-radius:32px;padding:32px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.hero:after{content:"Aa";position:absolute;right:30px;top:-42px;font-size:220px;font-weight:900;opacity:.055}
.eyebrow{font-size:11px;font-weight:900;letter-spacing:2px;text-transform:uppercase;opacity:.72}
h1{font-size:clamp(34px,6vw,58px);line-height:1;margin:8px 0}.hero p{max-width:720px;line-height:1.6;opacity:.9}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:22px}.stat{background:#ffffff16;border:1px solid #ffffff18;padding:14px;border-radius:17px}
.stat b{display:block;font-size:23px}.stat span{font-size:10px;opacity:.75}.progress{height:10px;background:#ffffff22;border-radius:99px;overflow:hidden;margin-top:16px}
.progress>div{height:100%;background:#fff;width:0;transition:.3s}.tabs{display:flex;gap:8px;overflow:auto;margin:22px 0;padding:3px}
.tab{border:0;background:#fff;color:var(--muted);padding:11px 15px;border-radius:99px;cursor:pointer;white-space:nowrap;box-shadow:0 3px 15px #0000000a}
.tab.active{background:var(--ink);color:#fff}.panel{display:none}.panel.active{display:block;animation:fade .2s}@keyframes fade{from{opacity:.2;transform:translateY(5px)}to{opacity:1}}
.box{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:24px}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:16px}
.search,.select,.input{border:1px solid var(--line);background:#fff;border-radius:14px;padding:12px 14px;outline:0}.search{flex:1;min-width:220px}
.btn{border:0;border-radius:12px;padding:10px 13px;font-weight:800;cursor:pointer}.primary{background:var(--soft);color:var(--purple)}.dark{background:var(--ink);color:#fff}
.good{background:var(--greenSoft);color:var(--green)}.bad{background:var(--redSoft);color:var(--red)}.gold{background:var(--goldSoft);color:#a56d00}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.wordCard{background:#fff;border:1px solid var(--line);border-radius:20px;padding:19px;box-shadow:0 7px 25px #1f1f3809}
.wordTop{display:flex;justify-content:space-between;gap:12px}.word{font-size:25px;font-weight:900}.meaning{color:var(--purple);font-weight:750;margin-top:3px}
.pron{display:inline-block;background:var(--goldSoft);color:#875a00;border-radius:10px;padding:7px 10px;margin-top:10px;font-weight:800}
.example{background:#f8f8fc;padding:12px;border-radius:12px;margin:12px 0;line-height:1.5}.actions{display:flex;gap:7px;flex-wrap:wrap}.badge{font-size:10px;font-weight:900;background:#f2f2f7;color:#777;padding:5px 8px;border-radius:8px;display:inline-block;margin-top:10px}
.sectionTitle{font-size:30px;margin:4px 0 8px}.sub{color:var(--muted);line-height:1.6}.lessonSteps{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:18px 0}
.step{padding:12px;border-radius:14px;background:#f7f7fb;text-align:center;font-size:12px;font-weight:800}.step.done{background:var(--greenSoft);color:var(--green)}
.storyList{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.storyTile{padding:20px;border:1px solid var(--line);border-radius:20px;background:#fff;cursor:pointer}
.storyTile:hover{transform:translateY(-2px);box-shadow:var(--shadow)}.storyReader{max-width:900px;margin:auto}.sentence{border:1px solid var(--line);border-radius:16px;padding:15px;margin:10px 0;background:#fff}
.sentence.active{border-color:var(--purple);box-shadow:0 0 0 3px var(--soft)}.sentenceText{font-size:18px;line-height:1.7}.translation{display:none;color:var(--muted);margin-top:8px}.translation.show{display:block}
.storyProgress{height:9px;background:#eeeef5;border-radius:99px;overflow:hidden}.storyProgress div{height:100%;background:var(--purple);width:0}
.flash{max-width:760px;margin:20px auto;text-align:center;min-height:330px;display:flex;flex-direction:column;justify-content:center}.flashWord{font-size:48px;font-weight:900}.hidden{display:none!important}
.quizQ{font-size:25px;font-weight:900;margin:14px 0}.options{display:grid;gap:9px}.option{padding:14px;border:1px solid var(--line);background:#fff;border-radius:13px;text-align:left;cursor:pointer}.option.ok{background:var(--greenSoft);border-color:var(--green)}.option.no{background:var(--redSoft);border-color:var(--red)}
.gameGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.game{min-height:220px}.hangWord{font-size:34px;letter-spacing:8px;font-weight:900;margin:18px 0}.letters{display:flex;gap:5px;flex-wrap:wrap}
.letter{width:36px;height:36px;border:0;border-radius:9px;background:#f0effb;cursor:pointer;font-weight:800}.letter:disabled{opacity:.3}
.crossGrid{display:grid;grid-template-columns:repeat(12,30px);gap:2px;justify-content:start;overflow:auto;margin-top:15px}.cell{width:30px;height:30px;border:1px solid #ddd;border-radius:4px;text-align:center;text-transform:uppercase;font-weight:800}.black{background:#232334;border-color:#232334}
.song{white-space:pre-line;font-size:18px;line-height:1.8;background:linear-gradient(135deg,#fff7e6,#efedff);padding:24px;border-radius:22px}.chorus{font-weight:900;color:var(--purple)}
.dictation{max-width:760px;margin:auto}.bigInput{width:100%;padding:15px;border:1px solid var(--line);border-radius:14px;margin:12px 0}.feedback{padding:13px;border-radius:13px;margin-top:10px}
.todayGrid{display:grid;grid-template-columns:1.3fr .7fr;gap:14px}.mission{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.footer{text-align:center;color:var(--muted);font-size:12px;margin-top:35px}
@media(max-width:850px){.stats{grid-template-columns:repeat(2,1fr)}.grid,.storyList,.gameGrid,.todayGrid{grid-template-columns:1fr}.lessonSteps{grid-template-columns:1fr 1fr}.crossGrid{grid-template-columns:repeat(12,27px)}.cell{width:27px;height:27px}.hero{padding:25px 20px}}

/* V3 mobile-first additions */
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}
button,.tab,.wordCard,.storyTile{-webkit-tap-highlight-color:transparent}
button{touch-action:manipulation}
.mobileDock{display:none}
.installHint{margin-top:14px;background:#ffffff13;border:1px solid #ffffff22;border-radius:14px;padding:10px 12px;font-size:12px}
@media(max-width:700px){
  .app{padding:12px 12px calc(92px + env(safe-area-inset-bottom))}
  .hero{border-radius:24px;padding:23px 18px}
  h1{font-size:36px}
  .hero p{font-size:14px}
  .stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .stat{padding:11px}.stat b{font-size:20px}
  .tabs{display:none}
  .panel{padding-top:14px}
  .box{padding:18px;border-radius:20px}
  .sectionTitle{font-size:26px}
  .word{font-size:23px}
  .wordCard{padding:16px}
  .actions .btn{min-height:44px}
  .search,.select,.input,.bigInput{font-size:16px;min-height:46px}
  .toolbar{position:sticky;top:0;z-index:10;background:rgba(246,247,251,.94);backdrop-filter:blur(10px);padding:8px 0}
  .storyTile{min-height:130px}
  .sentence{padding:14px}.sentenceText{font-size:17px}
  .flash{min-height:390px}.flashWord{font-size:39px}
  .gameGrid{gap:12px}
  .lessonSteps{grid-template-columns:repeat(2,minmax(0,1fr))}
  .mobileDock{display:grid;grid-template-columns:repeat(5,1fr);position:fixed;z-index:999;left:8px;right:8px;bottom:calc(8px + env(safe-area-inset-bottom));background:rgba(23,23,42,.96);backdrop-filter:blur(18px);padding:7px;border-radius:20px;box-shadow:0 14px 40px rgba(0,0,0,.25)}
  .dockBtn{border:0;background:transparent;color:#c8c7d8;border-radius:14px;padding:7px 2px;font-size:10px;font-weight:800;min-width:0}
  .dockBtn span{display:block;font-size:20px;margin-bottom:2px}
  .dockBtn.active{background:#ffffff18;color:#fff}
}

</style>
</head>
<body>
<div class="app">
<section class="hero">
 <div class="eyebrow">Pam's English Lab PRO · B1 → B2 → C1</div>
 <h1>English, but make it addictive ✨</h1>
 <p>Vocabulary, pronunciation, stories, shadowing, dictation, active recall, games and speaking practice — all in one place.</p>
 <div class="stats">
  <div class="stat"><b id="sWords">40</b><span>WORDS</span></div>
  <div class="stat"><b id="sLearned">0</b><span>LEARNED</span></div>
  <div class="stat"><b id="sReview">0</b><span>TO REVIEW</span></div>
  <div class="stat"><b id="sScore">0%</b><span>QUIZ SCORE</span></div>
  <div class="stat"><b id="sLesson">0%</b><span>LESSON</span></div>
 </div>
 <div class="progress"><div id="globalProgress"></div></div>
<div class="installHint">📱 iPhone/iPad: Safari → Compartir → Añadir a pantalla de inicio. Android/Chrome: menú → Instalar app.</div>
</section>

<nav class="tabs">
 <button class="tab active" data-p="today">🏠 Today</button><button class="tab" data-p="vocab">📚 Vocabulary</button>
 <button class="tab" data-p="stories">📖 Stories</button><button class="tab" data-p="shadow">🎧 Shadowing</button>
 <button class="tab" data-p="dictation">✍️ Dictation</button><button class="tab" data-p="flash">🃏 Flashcards</button>
 <button class="tab" data-p="quiz">🧠 Quiz</button><button class="tab" data-p="games">🎮 Games</button>
 <button class="tab" data-p="song">🎵 Song</button><button class="tab" data-p="speaking">🗣️ Speaking</button>
 <button class="tab" data-p="review">⭐ Review</button>
</nav>

<section id="today" class="panel active">
 <div class="todayGrid">
  <div class="box">
   <div class="eyebrow" style="color:var(--purple)">Today's mission · ~30 min</div><h2 class="sectionTitle">One lesson. Five wins.</h2>
   <div class="lessonSteps" id="lessonSteps"></div>
   <div id="missions"></div>
  </div>
  <div class="box"><div class="eyebrow" style="color:var(--green)">Memory engine</div><h2 class="sectionTitle">How we learn</h2>
   <p class="sub">1. <b>Recall</b> before looking.<br>2. <b>Hear + repeat</b> aloud.<br>3. Use the word in <b>your own sentence</b>.<br>4. Meet it again inside a <b>story</b>.<br>5. Review difficult words later.</p>
   <div class="example"><b>Rule:</b> recognition feels easy; retrieval creates memory.</div>
  </div>
 </div>
</section>

<section id="vocab" class="panel">
 <div class="toolbar"><input id="search" class="search" placeholder="🔎 Search word or meaning"><select id="filter" class="select"><option value="all">All</option><option value="EOI">EOI</option><option value="Extra">B1+/B2 extras</option></select><button class="btn primary" id="hideMeanings">🙈 Hide meanings</button></div>
 <div id="wordGrid" class="grid"></div>
</section>

<section id="stories" class="panel">
 <div id="storyChooser"><h2 class="sectionTitle">Curious Stories 📖</h2><p class="sub">Read for meaning first. Then train sentence by sentence.</p><div id="storyList" class="storyList"></div></div>
 <div id="storyReader" class="storyReader hidden"></div>
</section>

<section id="shadow" class="panel"><div class="box dictation">
 <div class="eyebrow" style="color:var(--purple)">Listen → copy rhythm → repeat</div><h2 class="sectionTitle">Shadowing Gym 🎧</h2>
 <p class="sub">Don't chase every sound. Copy the rhythm, stress and pauses.</p><div id="shadowSentence" class="example" style="font-size:21px"></div>
 <div id="shadowPron" class="pron"></div><div class="actions" style="margin-top:15px"><button class="btn primary" id="shadowPlay">🔊 Normal</button><button class="btn gold" id="shadowSlow">🐢 Slow</button><button class="btn dark" id="shadowNext">Next →</button></div>
 </div></section>

<section id="dictation" class="panel"><div class="box dictation">
 <div class="eyebrow" style="color:var(--purple)">No peeking</div><h2 class="sectionTitle">Dictation ✍️</h2>
 <p class="sub">Listen, type exactly what you hear, then check.</p><div class="actions"><button class="btn primary" id="dictPlay">🔊 Play</button><button class="btn gold" id="dictSlow">🐢 Slow</button></div>
 <input id="dictInput" class="bigInput" placeholder="Type what you hear..."><button class="btn dark" id="dictCheck">Check answer</button><button class="btn primary" id="dictNext">New sentence</button><div id="dictFeedback"></div>
 </div></section>

<section id="flash" class="panel"><div class="box flash">
 <div class="eyebrow" style="color:var(--purple)">Active recall</div><div id="flashWord" class="flashWord"></div><div id="flashPron" class="pron hidden"></div><div id="flashAnswer" class="hidden"><div id="flashMeaning" class="meaning"></div><div id="flashExample" class="example"></div></div>
 <div class="actions" style="justify-content:center;margin-top:15px"><button class="btn primary" id="flashListen">🔊 Listen</button><button class="btn dark" id="flashReveal">Reveal</button><button class="btn bad" id="flashHard">😵 Again</button><button class="btn good" id="flashKnow">🧠 Easy</button></div>
 </div></section>

<section id="quiz" class="panel"><div class="box dictation"><div class="eyebrow" style="color:var(--purple)">Retrieval practice</div><h2 class="sectionTitle">Quiz 🧠</h2><div id="quizMeta" class="sub"></div><div id="quizQ" class="quizQ"></div><div id="quizOptions" class="options"></div><button id="quizNext" class="btn dark hidden" style="margin-top:14px">Next →</button></div></section>

<section id="games" class="panel">
 <h2 class="sectionTitle">Game Arcade 🎮</h2><p class="sub">Practice should sometimes feel like play.</p>
 <div class="gameGrid">
  <div class="box game"><div class="eyebrow" style="color:var(--red)">Hangman</div><h3>Guess the personality word</h3><div id="hangHint" class="meaning"></div><div id="hangWord" class="hangWord"></div><div id="hangLives"></div><div id="letters" class="letters"></div><button id="hangNew" class="btn dark" style="margin-top:12px">New word</button></div>
  <div class="box game"><div class="eyebrow" style="color:var(--gold)">Mini Crossword</div><h3>Vocabulary blocks</h3><p class="sub">Fill the horizontal words from the clues. Accents are ignored.</p><div id="crossClues"></div><div id="crossGrid" class="crossGrid"></div><button id="crossCheck" class="btn dark" style="margin-top:12px">Check crossword</button><div id="crossMsg"></div></div>
 </div>
</section>

<section id="song" class="panel"><div class="box">
 <div class="eyebrow" style="color:var(--purple)">Original memory song</div><h2 class="sectionTitle">🎵 The Personality Song</h2>
 <p class="sub">A deliberately repetitive original song using all 40 lesson words. Read it rhythmically, then use Play by verse.</p>
 <div class="actions" id="songButtons" style="margin-bottom:15px"></div><div id="songLyrics" class="song"></div>
 </div></section>

<section id="speaking" class="panel"><div class="box dictation">
 <div class="eyebrow" style="color:var(--purple)">Speaking checkpoint</div><h2 class="sectionTitle">Talk, don't translate 🗣️</h2>
 <div id="speakPrompt" class="quizQ"></div><div id="speakWords" class="example"></div>
 <p class="sub">Speak for 60–90 seconds. Then use ChatGPT Voice and ask: <b>“Evaluate my speaking: fluency, grammar, vocabulary, pronunciation and clarity. Give me 3 corrections and one thing to practise next.”</b></p>
 <div class="actions"><button id="speakNew" class="btn dark">New challenge</button><button id="speakDone" class="btn good">✓ I completed it</button></div>
 <div class="example" style="margin-top:18px"><b>Speaking rubric / 20:</b><br>Fluency 0–4 · Grammar 0–4 · Vocabulary 0–4 · Pronunciation 0–4 · Clarity 0–4.<br><small>This HTML can play audio and structure practice, but it does not itself send your microphone audio to ChatGPT. Do the live evaluation in ChatGPT Voice.</small></div>
 </div></section>

<section id="review" class="panel"><div class="box"><h2 class="sectionTitle">Smart Review ⭐</h2><p class="sub">Words you miss in quizzes or mark as difficult appear here.</p><div id="reviewList"></div><button id="reset" class="btn bad">Reset progress</button></div></section>

<nav class="mobileDock" aria-label="Mobile navigation">
 <button class="dockBtn active" data-p="today"><span>🏠</span>Today</button>
 <button class="dockBtn" data-p="vocab"><span>📚</span>Words</button>
 <button class="dockBtn" data-p="stories"><span>📖</span>Stories</button>
 <button class="dockBtn" data-p="shadow"><span>🎧</span>Listen</button>
 <button class="dockBtn" data-p="games"><span>🎮</span>Games</button>
</nav>

<div class="footer">Pam's English Lab PRO · progress is stored locally in this browser ✨</div>
</div>

<script>
const W=[
["confident","seguro/a de sí mismo/a","KÓN-fi-dent","I'm quite confident when I know what I'm doing.","EOI"],
["friendly","amable, simpático/a","FRÉND-li","She's friendly with new people.","EOI"],
["funny","gracioso/a","FÁ-ni","My friends say I'm funny.","EOI"],
["generous","generoso/a","YÉ-ne-res","He's very generous with his friends.","EOI"],
["hardworking","trabajador/a","JARD-uér-king","I consider myself a hardworking person.","EOI"],
["helpful","servicial, dispuesto/a a ayudar","JÉLP-ful","My colleague is always helpful.","EOI"],
["impatient","impaciente","im-PÉI-shent","I can be impatient sometimes.","EOI"],
["kind","amable, bondadoso/a","KÁIND","She's a very kind person.","EOI"],
["lazy","perezoso/a","LÉI-si","I can be a bit lazy on Sundays.","EOI"],
["patient","paciente","PÉI-shent","I'm quite patient with other people.","EOI"],
["quiet","callado/a, tranquilo/a","KUÁI-et","I'm usually quiet around people I don't know.","EOI"],
["selfish","egoísta","SÉL-fish","I don't consider myself selfish.","EOI"],
["serious","serio/a","SÍ-ri-es","I can be very serious at work.","EOI"],
["shy","tímido/a","SHÁI","I was quite shy when I was younger.","EOI"],
["talkative","hablador/a","TÓ-ka-tiv","I'm very talkative with my friends.","EOI"],
["trustworthy","digno/a de confianza","TRÁST-uér-di","My friends say I'm trustworthy.","EOI"],
["outgoing","extrovertido/a, sociable","ÁUT-gou-ing","I'm quite outgoing with my friends.","Extra"],
["open-minded","de mente abierta","ÓU-pen MÁIN-did","I consider myself an open-minded person.","Extra"],
["easy-going","relajado/a, de trato fácil","Í-si GÓU-ing","My partner is very easy-going.","Extra"],
["ambitious","ambicioso/a","am-BÍ-shes","I'm ambitious about my career.","Extra"],
["determined","determinado/a","di-TÉR-mind","I'm very determined when I have a goal.","Extra"],
["curious","curioso/a","KIÚ-ri-es","I'm curious and I love learning new things.","Extra"],
["reliable","fiable, alguien con quien puedes contar","ri-LÁI-a-bol","My colleagues know I'm reliable.","Extra"],
["organized","organizado/a","ÓR-ga-naizd","I'm organized at work, but not always at home.","Extra"],
["stubborn","testarudo/a, cabezota","STÁ-born","I can be stubborn sometimes.","Extra"],
["competitive","competitivo/a","kem-PÉ-ti-tiv","I'm quite competitive when I play sports.","Extra"],
["sensitive","sensible, emocional","SÉN-si-tiv","I'm quite sensitive to criticism.","Extra"],
["sensible","sensato/a, razonable","SÉN-si-bol","She's sensible when making important decisions.","Extra"],
["moody","de humor cambiante","MÚ-di","I can be a little moody when I'm tired.","Extra"],
["independent","independiente","in-di-PÉN-dent","I've always been quite independent.","Extra"],
["creative","creativo/a","kri-ÉI-tiv","I'm a creative person and I enjoy developing new ideas.","Extra"],
["optimistic","optimista","op-ti-MÍS-tik","I'm usually optimistic about the future.","Extra"],
["pessimistic","pesimista","pe-si-MÍS-tik","I try not to be too pessimistic.","Extra"],
["honest","honesto/a, sincero/a","Ó-nist","I value people who are honest with me.","Extra"],
["responsible","responsable","ri-SPÓN-sa-bol","I'm a responsible person, especially at work.","Extra"],
["supportive","alguien que apoya a los demás","sa-PÓR-tiv","I try to be supportive when my friends have problems.","Extra"],
["bossy","mandón/a","BÓ-si","I can be a little bossy when I'm stressed.","Extra"],
["calm","tranquilo/a","KÁAM","I usually stay calm under pressure.","Extra"],
["cheerful","alegre, de buen ánimo","CHÍR-ful","She's cheerful and makes people laugh.","Extra"],
["thoughtful","considerado/a, atento/a","THÓT-ful","He's very thoughtful and always remembers important dates.","Extra"]
].map((x,i)=>({id:i,word:x[0],meaning:x[1],pron:x[2],example:x[3],source:x[4]}));

const stories=[
{title:"The Woman Who Survived Three Ship Disasters",emoji:"🚢",level:"B1+/B2",sentences:[
["Violet Jessop was a calm and determined woman who worked on some of the most famous ships of the early twentieth century.","Violet Jessop era una mujer tranquila y decidida que trabajó en algunos de los barcos más famosos de principios del siglo XX."],
["She was hardworking, reliable and remarkably brave, although she rarely described herself that way.","Era trabajadora, fiable y extraordinariamente valiente, aunque rara vez se describía así."],
["In 1911, she was on the Olympic when it collided with another ship, but she survived.","En 1911 estaba en el Olympic cuando chocó con otro barco, pero sobrevivió."],
["One year later, Violet was working on the Titanic when it struck an iceberg in the North Atlantic.","Un año después, Violet trabajaba en el Titanic cuando chocó con un iceberg en el Atlántico Norte."],
["She helped passengers into lifeboats and remained patient even while the situation became terrifying.","Ayudó a los pasajeros a subir a los botes salvavidas y mantuvo la paciencia incluso cuando la situación se volvió aterradora."],
["Violet survived again, but her extraordinary story did not end there.","Violet sobrevivió de nuevo, pero su extraordinaria historia no terminó ahí."],
["During the First World War, she worked as a nurse on the Britannic, which also sank after an explosion.","Durante la Primera Guerra Mundial trabajó como enfermera en el Britannic, que también se hundió tras una explosión."],
["Once again, she escaped and lived to tell the story.","Una vez más, escapó y vivió para contarlo."],
["Her experience made her independent and sensible, but it did not make her pessimistic.","Su experiencia la hizo independiente y sensata, pero no pesimista."],
["She continued working at sea for years, showing how resilient and optimistic a person can be after frightening experiences.","Continuó trabajando en el mar durante años, mostrando lo resiliente y optimista que puede ser una persona después de experiencias aterradoras."]
]},
{title:"The Strange Intelligence of Octopuses",emoji:"🐙",level:"B1+/B2",sentences:[
["Octopuses are curious animals with a form of intelligence that developed very differently from ours.","Los pulpos son animales curiosos con una forma de inteligencia que se desarrolló de manera muy distinta a la nuestra."],
["They are usually independent and quiet because most species do not live in social groups.","Normalmente son independientes y tranquilos porque la mayoría de las especies no viven en grupos sociales."],
["In experiments, some octopuses have opened jars, solved puzzles and escaped from tanks.","En experimentos, algunos pulpos han abierto frascos, resuelto rompecabezas y escapado de tanques."],
["Researchers have even reported that individual animals can behave differently with different people.","Los investigadores incluso han informado que animales individuales pueden comportarse de forma diferente con distintas personas."],
["An octopus can be patient while exploring an object and suddenly become surprisingly determined when food is involved.","Un pulpo puede ser paciente mientras explora un objeto y de repente volverse sorprendentemente decidido cuando hay comida de por medio."],
["Their flexible bodies also make them creative problem solvers.","Sus cuerpos flexibles también los convierten en solucionadores creativos de problemas."],
["They can change colour, squeeze through tiny spaces and use objects in their environment.","Pueden cambiar de color, pasar por espacios diminutos y usar objetos de su entorno."],
["Scientists remain open-minded about what these abilities tell us about consciousness.","Los científicos mantienen una mente abierta sobre lo que estas habilidades nos dicen acerca de la conciencia."],
["The more we study them, the more sensible it seems to question our old ideas about animal intelligence.","Cuanto más los estudiamos, más sensato parece cuestionar nuestras antiguas ideas sobre la inteligencia animal."],
["Perhaps intelligence does not need to look friendly, talkative or even familiar to be extraordinary.","Quizá la inteligencia no necesita parecer amistosa, habladora ni siquiera familiar para ser extraordinaria."]
]},
{title:"Why Your Memory Can Lie to You",emoji:"🧠",level:"B2",sentences:[
["Many confident people believe that memory works like a camera, but the brain is far more creative than that.","Muchas personas seguras creen que la memoria funciona como una cámara, pero el cerebro es mucho más creativo que eso."],
["Every time you remember an event, your brain reconstructs parts of the experience.","Cada vez que recuerdas un acontecimiento, tu cerebro reconstruye partes de la experiencia."],
["That means two honest and trustworthy people can remember the same event differently.","Eso significa que dos personas honestas y dignas de confianza pueden recordar el mismo acontecimiento de forma diferente."],
["One person may focus on cheerful moments while another remembers the serious or stressful parts.","Una persona puede centrarse en los momentos alegres mientras otra recuerda las partes serias o estresantes."],
["Neither person needs to be selfish or dishonest for their memories to disagree.","Ninguna de las dos personas tiene que ser egoísta o deshonesta para que sus recuerdos no coincidan."],
["Researchers have shown that questions asked after an event can influence later memories.","Los investigadores han demostrado que las preguntas formuladas después de un acontecimiento pueden influir en los recuerdos posteriores."],
["This is why sensible investigators are careful about the way they interview witnesses.","Por eso los investigadores sensatos tienen cuidado con la forma en que entrevistan a los testigos."],
["Human memory is powerful, helpful and sometimes surprisingly unreliable.","La memoria humana es poderosa, útil y a veces sorprendentemente poco fiable."],
["Being open-minded about our own mistakes can therefore be more responsible than being stubbornly certain.","Tener una mente abierta sobre nuestros propios errores puede ser más responsable que estar obstinadamente seguros."],
["The strange lesson is that remembering is not simply finding the past; it is partly rebuilding it.","La extraña lección es que recordar no es simplemente encontrar el pasado; es en parte reconstruirlo."]
]}];

const songVerses=[
`VERSE 1
Confident, friendly, funny and kind,
Generous, helpful, open-minded mind.
Hardworking, patient, calm when I can,
Curious and thoughtful — that's part of the plan.`,
`CHORUS
I can be shy, I can be outgoing,
Easy-going, learning and growing.
Reliable, honest, determined too,
Forty little words to describe what we do.`,
`VERSE 2
Talkative, serious, quiet sometimes,
Creative and cheerful, making new rhymes.
Ambitious, responsible, ready to try,
Independent and optimistic — aiming high.`,
`VERSE 3
Impatient, lazy, selfish? Maybe not!
Stubborn and bossy when things get hot.
Moody and sensitive, sensible too,
Competitive energy coming right through.`,
`VERSE 4
Organized, supportive, trustworthy and bright,
Pessimistic moments don't have to be right.
Every personality changes and grows,
The more English I practise, the more English flows.`,
`FINAL CHORUS
Confident, friendly — listen and say,
Learn it, recall it, use it today.
From B1 to B2, then C1 in view,
Forty personality words — I know what to do!`
];

let learned=JSON.parse(localStorage.getItem("pelLearned")||"[]");
let review=JSON.parse(localStorage.getItem("pelReview")||"[]");
let qCorrect=+(localStorage.getItem("pelQC")||0),qTotal=+(localStorage.getItem("pelQT")||0);
let lesson=JSON.parse(localStorage.getItem("pelLesson")||'{"vocab":false,"story":false,"shadow":false,"quiz":false,"speak":false}');
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
function save(){localStorage.setItem("pelLearned",JSON.stringify(learned));localStorage.setItem("pelReview",JSON.stringify(review));localStorage.setItem("pelQC",qCorrect);localStorage.setItem("pelQT",qTotal);localStorage.setItem("pelLesson",JSON.stringify(lesson));stats()}
function speak(t,slow=false){if(!("speechSynthesis"in window)){alert("Try Chrome or Edge for speech.");return} speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(t);u.lang="en-GB";u.rate=slow?.62:.88;let vs=speechSynthesis.getVoices();u.voice=vs.find(v=>v.lang==="en-GB")||vs.find(v=>v.lang.startsWith("en"))||null;speechSynthesis.speak(u)}
function stats(){let lp=Math.round(Object.values(lesson).filter(Boolean).length/5*100);$("#sWords").textContent=W.length;$("#sLearned").textContent=learned.length;$("#sReview").textContent=review.length;$("#sScore").textContent=(qTotal?Math.round(qCorrect/qTotal*100):0)+"%";$("#sLesson").textContent=lp+"%";$("#globalProgress").style.width=lp+"%";renderMissions()}
function done(k){lesson[k]=true;save()}
function renderMissions(){let items=[["vocab","📚 Learn/review 5 words","Vocabulary"],["story","📖 Read one story section","Stories"],["shadow","🎧 Shadow 3 sentences","Shadowing"],["quiz","🧠 Complete a quiz","Quiz"],["speak","🗣️ Speak for 60–90 seconds","Speaking"]];$("#lessonSteps").innerHTML=items.map(x=>`<div class="step ${lesson[x[0]]?"done":""}">${lesson[x[0]]?"✓ ":""}${x[2]}</div>`).join("");$("#missions").innerHTML=items.map(x=>`<div class="mission"><span>${x[1]}</span><button class="btn ${lesson[x[0]]?"good":"primary"}" onclick="done('${x[0]}')">${lesson[x[0]]?"Done ✓":"Mark done"}</button></div>`).join("")}
let hide=false;
function renderWords(){let q=$("#search").value.toLowerCase(),f=$("#filter").value;let a=W.filter(w=>(f==="all"||w.source===f)&&(w.word.includes(q)||w.meaning.toLowerCase().includes(q)));$("#wordGrid").innerHTML=a.map(w=>`<article class="wordCard"><div class="wordTop"><div><div class="word">${w.word}</div><div class="meaning" style="${hide?"filter:blur(6px)":""}">${w.meaning}</div><div class="pron">🗣️ ${w.pron}</div></div><button class="btn ${review.includes(w.id)?"bad":"primary"}" onclick="toggleReview(${w.id})">${review.includes(w.id)?"★":"☆"}</button></div><div class="example">${w.example}</div><div class="actions"><button class="btn primary" onclick="speak('${esc(w.word)}')">🔊 Word</button><button class="btn gold" onclick="speak('${esc(w.word)}',true)">🐢 Slow</button><button class="btn primary" onclick="speak('${esc(w.example)}')">🔊 Example</button><button class="btn ${learned.includes(w.id)?"good":"dark"}" onclick="toggleLearn(${w.id})">${learned.includes(w.id)?"✓ Learned":"Mark learned"}</button></div><span class="badge">${w.source==="EOI"?"EOI · B1.1":"B1+/B2 EXTRA"}</span></article>`).join("")}
function esc(s){return s.replaceAll("\\","\\\\").replaceAll("'","\\'")}
function toggleLearn(id){learned=learned.includes(id)?learned.filter(x=>x!==id):[...learned,id];save();renderWords()}
function toggleReview(id){review=review.includes(id)?review.filter(x=>x!==id):[...review,id];save();renderWords();renderReview()}
$("#search").oninput=renderWords;$("#filter").onchange=renderWords;$("#hideMeanings").onclick=()=>{hide=!hide;$("#hideMeanings").textContent=hide?"👀 Show meanings":"🙈 Hide meanings";renderWords()};

function renderStories(){$("#storyList").innerHTML=stories.map((s,i)=>`<div class="storyTile" onclick="openStory(${i})"><div style="font-size:38px">${s.emoji}</div><h3>${s.title}</h3><span class="badge">${s.level}</span><p class="sub">${s.sentences.length} sentence trainer steps</p></div>`).join("")}
function openStory(i){let s=stories[i];$("#storyChooser").classList.add("hidden");$("#storyReader").classList.remove("hidden");$("#storyReader").innerHTML=`<button class="btn primary" onclick="closeStory()">← Stories</button><h2 class="sectionTitle">${s.emoji} ${s.title}</h2><div class="storyProgress"><div id="sp"></div></div><p class="sub">Tap each sentence. Listen → repeat → reveal translation only if needed.</p><div class="actions"><button class="btn dark" onclick="playStory(${i})">▶ Full story</button></div><div>${s.sentences.map((x,j)=>`<div class="sentence" id="sen${j}" onclick="markSentence(${j},${s.sentences.length})"><div class="sentenceText">${x[0]}</div><div class="actions"><button class="btn primary" onclick="event.stopPropagation();speak('${esc(x[0])}')">🔊 Play</button><button class="btn gold" onclick="event.stopPropagation();speak('${esc(x[0])}',true)">🐢 Slow</button><button class="btn primary" onclick="event.stopPropagation();this.closest('.sentence').querySelector('.translation').classList.toggle('show')">🇪🇸 Meaning</button></div><div class="translation">${x[1]}</div></div>`).join("")}</div>`}
function closeStory(){$("#storyChooser").classList.remove("hidden");$("#storyReader").classList.add("hidden")}
function playStory(i){speak(stories[i].sentences.map(x=>x[0]).join(" "));done("story")}
let marked=new Set();function markSentence(j,n){marked.add(j);$("#sen"+j).classList.add("active");$("#sp").style.width=Math.round(marked.size/n*100)+"%";if(marked.size>=Math.min(5,n))done("story")}

let shadowI=0;const shadowS=stories.flatMap(s=>s.sentences.map(x=>x[0]));
function renderShadow(){let t=shadowS[shadowI%shadowS.length];$("#shadowSentence").textContent=t;$("#shadowPron").textContent="Tip: listen first. Then copy the stress and rhythm, not just each word."}
$("#shadowPlay").onclick=()=>{speak(shadowS[shadowI%shadowS.length]);done("shadow")};$("#shadowSlow").onclick=()=>speak(shadowS[shadowI%shadowS.length],true);$("#shadowNext").onclick=()=>{shadowI++;renderShadow()};

let dictI=0;function dictText(){return W[dictI%W.length].example}$("#dictPlay").onclick=()=>speak(dictText());$("#dictSlow").onclick=()=>speak(dictText(),true);
$("#dictCheck").onclick=()=>{let a=$("#dictInput").value.trim().toLowerCase().replace(/[.,!?']/g,""),b=dictText().toLowerCase().replace(/[.,!?']/g,"");$("#dictFeedback").innerHTML=a===b?`<div class="feedback" style="background:var(--greenSoft)">✓ Perfect!</div>`:`<div class="feedback" style="background:var(--redSoft)"><b>Correct:</b> ${dictText()}</div>`}
$("#dictNext").onclick=()=>{dictI=Math.floor(Math.random()*W.length);$("#dictInput").value="";$("#dictFeedback").innerHTML=""};

let fi=Math.floor(Math.random()*W.length);function renderFlash(){let w=W[fi];$("#flashWord").textContent=w.word;$("#flashPron").textContent="🗣️ "+w.pron;$("#flashMeaning").textContent=w.meaning;$("#flashExample").textContent=w.example;$("#flashAnswer").classList.add("hidden");$("#flashPron").classList.add("hidden")}
$("#flashListen").onclick=()=>speak(W[fi].word);$("#flashReveal").onclick=()=>{$("#flashAnswer").classList.remove("hidden");$("#flashPron").classList.remove("hidden")};
$("#flashHard").onclick=()=>{if(!review.includes(fi))review.push(fi);save();fi=Math.floor(Math.random()*W.length);renderFlash();renderReview()};
$("#flashKnow").onclick=()=>{if(!learned.includes(fi))learned.push(fi);review=review.filter(x=>x!==fi);save();fi=Math.floor(Math.random()*W.length);renderFlash()};

let qNow=null,qN=1,qAnswered=false;function shuffle(a){return [...a].sort(()=>Math.random()-.5)}
function newQuiz(){qAnswered=false;$("#quizNext").classList.add("hidden");qNow=W[Math.floor(Math.random()*W.length)];let opts=shuffle([qNow,...shuffle(W.filter(x=>x.id!==qNow.id)).slice(0,3)]),rev=Math.random()>.5;$("#quizMeta").textContent=`Question ${qN} · Lifetime score ${qCorrect}/${qTotal}`;$("#quizQ").innerHTML=rev?`How do you say <span style="color:var(--purple)">"${qNow.meaning}"</span>?`:`What does <span style="color:var(--purple)">"${qNow.word}"</span> mean?`;$("#quizOptions").innerHTML=opts.map(o=>`<button class="option" data-ok="${o.id===qNow.id}" onclick="answerQ(this)">${rev?o.word:o.meaning}</button>`).join("")}
function answerQ(b){if(qAnswered)return;qAnswered=true;qTotal++;let ok=b.dataset.ok==="true";if(ok){qCorrect++;b.classList.add("ok")}else{b.classList.add("no");$$(".option").forEach(x=>{if(x.dataset.ok==="true")x.classList.add("ok")});if(!review.includes(qNow.id))review.push(qNow.id)}save();done("quiz");$("#quizNext").classList.remove("hidden");renderReview()}
$("#quizNext").onclick=()=>{qN++;newQuiz()};

let hang=null,guessed=new Set(),lives=6;function newHang(){hang=W[Math.floor(Math.random()*W.length)];guessed=new Set();lives=6;renderHang()}
function renderHang(){let letters="ABCDEFGHIJKLMNOPQRSTUVWXYZ";$("#hangHint").textContent=hang.meaning;$("#hangWord").textContent=hang.word.toUpperCase().split("").map(c=>c==="-"?"-":guessed.has(c) ? c:"_").join(" ");$("#hangLives").textContent=`❤️ Lives: ${lives}`;$("#letters").innerHTML=letters.split("").map(c=>`<button class="letter" ${guessed.has(c)?"disabled":""} onclick="guess('${c}')">${c}</button>`).join("");let won=hang.word.toUpperCase().split("").every(c=>c==="-"||guessed.has(c));if(won)$("#hangLives").innerHTML="🎉 You got it!";if(lives<=0)$("#hangLives").innerHTML=`💀 The word was <b>${hang.word}</b>`}
function guess(c){if(lives<=0)return;guessed.add(c);if(!hang.word.toUpperCase().includes(c))lives--;renderHang()}$("#hangNew").onclick=newHang;

const crossWords=[W[0],W[8],W[13],W[17],W[24]];function renderCross(){let rows=5,cols=12,grid=Array.from({length:rows},()=>Array(cols).fill(null));crossWords.forEach((w,r)=>{[...w.word.replace("-","")].slice(0,cols).forEach((c,i)=>grid[r][i]=c)});$("#crossClues").innerHTML=crossWords.map((w,i)=>`<div><b>${i+1}.</b> ${w.meaning}</div>`).join("");$("#crossGrid").innerHTML=grid.flatMap((row,r)=>row.map((c,i)=>c?`<input class="cell" maxlength="1" data-a="${c}" aria-label="row ${r+1} col ${i+1}">`:`<div class="cell black"></div>`)).join("")}
$("#crossCheck").onclick=()=>{let cells=$$("#crossGrid input"),ok=0;cells.forEach(c=>{let good=c.value.toLowerCase()===c.dataset.a.toLowerCase();c.style.background=good?"#eafaf4":"#fff0f3";if(good)ok++});$("#crossMsg").innerHTML=`<div class="feedback">${ok}/${cells.length} letters correct</div>`};

function renderSong(){$("#songButtons").innerHTML=songVerses.map((v,i)=>`<button class="btn ${i===1||i===5?"primary":"gold"}" onclick="speak(songVerses[${i}])">🔊 ${i===0?"Verse 1":i===1?"Chorus":i===2?"Verse 2":i===3?"Verse 3":i===4?"Verse 4":"Final chorus"}</button>`).join("");$("#songLyrics").innerHTML=songVerses.map((v,i)=>`<div class="${i===1||i===5?"chorus":""}">${v}</div><br>`).join("")}

const prompts=["Describe your personality now and how it has changed over the years.","Describe the personality of a person you admire. Give reasons and examples.","Which personality traits are most useful at work? Explain why.","What personality trait would you like to improve in yourself?","Do you think people can change their personality? Give your opinion."];
function newSpeak(){let p=prompts[Math.floor(Math.random()*prompts.length)],ws=shuffle(W).slice(0,3);$("#speakPrompt").textContent=p;$("#speakWords").innerHTML=`Try to use: <b>${ws.map(x=>x.word).join(" · ")}</b>`}
$("#speakNew").onclick=newSpeak;$("#speakDone").onclick=()=>done("speak");

function renderReview(){let a=W.filter(w=>review.includes(w.id));$("#reviewList").innerHTML=a.length?a.map(w=>`<div class="example"><b>${w.word}</b> — ${w.meaning} <span class="pron">${w.pron}</span> <button class="btn primary" onclick="speak('${esc(w.word)}')">🔊</button> <button class="btn good" onclick="toggleReview(${w.id})">✓ Remove</button></div>`).join(""):`<div class="example">🎉 No review words yet.</div>`}
$("#reset").onclick=()=>{if(confirm("Reset all saved progress?")){learned=[];review=[];qCorrect=qTotal=0;lesson={vocab:false,story:false,shadow:false,quiz:false,speak:false};save();renderWords();renderReview()}};


function switchPanel(p){
  $$(".tab,.dockBtn").forEach(x=>x.classList.toggle("active",x.dataset.p===p));
  $$(".panel").forEach(x=>x.classList.toggle("active",x.id===p));
  window.scrollTo({top:0,behavior:"smooth"});
}
$$(".tab,.dockBtn").forEach(t=>t.onclick=()=>switchPanel(t.dataset.p));

renderWords();renderStories();renderShadow();renderFlash();newQuiz();newHang();renderCross();renderSong();newSpeak();renderReview();stats();
if("serviceWorker" in navigator){window.addEventListener("load",()=>navigator.serviceWorker.register("./sw.js").catch(()=>{}));}
</script>
</body></html>
